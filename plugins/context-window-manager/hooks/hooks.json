{
  "description": "Restate the validated project context policy when a Codex session starts or resumes after compaction; never edits configuration.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/scripts/context-window.ps1\" hook",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/context-window.ps1\" hook",
            "statusMessage": "Reading the project context profile",
            "additionalContextLimit": 800,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
