<Window x:Class="ContextMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Mini"
        Width="760"
        Height="660"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderBrush" Value="#E1E6ED" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#263445" />
            <Setter Property="BorderBrush" Value="#B8C3D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#1769E0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1769E0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="108" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="104" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#162A46">
            <Grid Margin="28,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Context Mini" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="独立管理 Codex 项目上下文请求与自动压缩阈值" Margin="0,5,0,0" Foreground="#C8D5E8" />
                </StackPanel>
                <Border Grid.Column="1" Background="#243F65" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="WPF · Local only" Foreground="#DCE9FA" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前项目" FontSize="13" FontWeight="SemiBold" Foreground="#66758A" />
                            <TextBlock x:Name="ProjectNameText" Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#1B2A3D" />
                            <TextBlock x:Name="ProjectPathText" Margin="0,3,16,0" Foreground="#6E7C8F" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="切换…" Style="{StaticResource SecondaryButton}" Click="SwitchProject_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="上下文配置" FontSize="18" FontWeight="SemiBold" Foreground="#1B2A3D" />
                        <TextBlock Text="预设和滑块只修改草稿；点击应用并确认后才写入项目。" Margin="0,4,0,16" Foreground="#66758A" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AutoButton" Content="Auto" Style="{StaticResource PresetButton}" Click="Auto_Click" />
                            <Button x:Name="CompactButton" Content="128K" Style="{StaticResource PresetButton}" Click="Compact_Click" />
                            <Button x:Name="BalancedButton" Content="400K" Style="{StaticResource PresetButton}" Click="Balanced_Click" />
                            <Button x:Name="OneMillionButton" Content="1.05M" Style="{StaticResource PresetButton}" Click="OneMillion_Click" />
                        </StackPanel>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="8,192" Foreground="#79879A" VerticalAlignment="Center" />
                            <Slider x:Name="WindowSlider"
                                    Grid.Column="1"
                                    Margin="14,0"
                                    Minimum="8192"
                                    Maximum="1050000"
                                    TickFrequency="1000"
                                    IsSnapToTickEnabled="False"
                                    ValueChanged="WindowSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" Text="1,050,000" Foreground="#79879A" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#F3F6FA" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="上下文请求值" Foreground="#6B788B" />
                                    <TextBlock x:Name="WindowValueText" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#17365F" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#F3F6FA" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="自动压缩阈值" Foreground="#6B788B" />
                                    <TextBlock x:Name="CompactValueText" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#17365F" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="WarningBorder" Margin="0,16,0,0" Background="#FFF6DB" BorderBrush="#E6C45D" BorderThickness="1" CornerRadius="8" Padding="12">
                            <TextBlock x:Name="WarningText" Foreground="#725713" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="磁盘状态" FontSize="13" FontWeight="SemiBold" Foreground="#66758A" />
                        <TextBlock x:Name="DiskStatusText" Margin="0,5,0,0" FontSize="16" Foreground="#25364B" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="#66758A" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EB" BorderThickness="0,1,0,0">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="这些数值是客户端配置请求，不能突破模型或账户的服务端硬上限。"
                           Foreground="#738095"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="重新加载" Style="{StaticResource SecondaryButton}" Margin="16,0,10,0" Click="Reload_Click" />
                <Button x:Name="ApplyButton" Grid.Column="2" Content="确认并应用" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
