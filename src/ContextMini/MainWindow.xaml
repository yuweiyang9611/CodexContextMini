<Window x:Class="ContextMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ContextMini.Core;assembly=ContextMini.Core"
        Title="Context Mini"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ControlHoverTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ControlHoverTextBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.48" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryActionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionBackgroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryActionHoverBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionHoverBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryActionPressedBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryActionTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryActionPressedBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="108" />
        </Style>
        <Style x:Key="NumericInput" TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AppearanceChoice" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource HeaderControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource HeaderControlTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HeaderControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource HeaderControlHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource HeaderControlHoverTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource HeaderSelectedBackgroundBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource HeaderSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource HeaderSelectedTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                MinHeight="112"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="Context Mini" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" />
                    <TextBlock Text="管理 Codex 全局默认与项目上下文设置"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource HeaderSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="外观" Margin="0,0,0,5" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource HeaderSecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" ToolTip="选择固定配色，或跟随 Windows 应用主题">
                        <RadioButton x:Name="SystemAppearanceButton"
                                     Content="跟随系统"
                                     GroupName="Appearance"
                                     Tag="{x:Static core:AppearancePreference.System}"
                                     Style="{StaticResource AppearanceChoice}"
                                     AutomationProperties.Name="跟随系统主题"
                                     Click="Appearance_Click" />
                        <RadioButton x:Name="LightAppearanceButton"
                                     Content="白色"
                                     GroupName="Appearance"
                                     Tag="{x:Static core:AppearancePreference.Light}"
                                     Style="{StaticResource AppearanceChoice}"
                                     Margin="6,0,0,0"
                                     AutomationProperties.Name="白色主题"
                                     Click="Appearance_Click" />
                        <RadioButton x:Name="DarkAppearanceButton"
                                     Content="黑色"
                                     GroupName="Appearance"
                                     Tag="{x:Static core:AppearancePreference.Dark}"
                                     Style="{StaticResource AppearanceChoice}"
                                     Margin="6,0,0,0"
                                     AutomationProperties.Name="黑色主题"
                                     Click="Appearance_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="配置范围" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="ProjectNameText"
                                       Margin="0,5,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="ProjectPathText" Margin="0,3,16,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TrustStatusText"
                                       Margin="0,8,16,0"
                                       Foreground="{DynamicResource TertiaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,12,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最近项目" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ComboBox x:Name="RecentProjectsCombo"
                                          Grid.Column="1"
                                          MinWidth="160"
                                          MaxWidth="440"
                                          HorizontalAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.Name="最近项目" />
                                <Button Grid.Column="2"
                                        Content="打开"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        Click="OpenRecentProject_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button x:Name="GlobalSettingsButton"
                                    Content="全局默认"
                                    AutomationProperties.Name="编辑全局默认上下文"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="GlobalSettings_Click" />
                            <Button Content="选择项目…"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SwitchProject_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="上下文配置" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="预设和滑块只修改草稿；预览并确认后写入当前范围。" Margin="0,4,0,16" Foreground="{DynamicResource SecondaryTextBrush}" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AutoButton" Content="Auto" Style="{StaticResource PresetButton}" Click="Auto_Click" />
                            <Button x:Name="CompactButton" Content="128K" Style="{StaticResource PresetButton}" Click="Compact_Click" />
                            <Button x:Name="BalancedButton" Content="400K" Style="{StaticResource PresetButton}" Click="Balanced_Click" />
                            <Button x:Name="OneMillionButton" Content="1.05M" Style="{StaticResource PresetButton}" Click="OneMillion_Click" />
                        </StackPanel>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="8,192" Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="WindowSlider"
                                    Grid.Column="1"
                                    Margin="14,0"
                                    Minimum="8192"
                                    Maximum="1050000"
                                    TickFrequency="1000"
                                    IsSnapToTickEnabled="False"
                                    AutomationProperties.Name="上下文请求值滑块"
                                    ValueChanged="WindowSlider_ValueChanged" />
                            <TextBlock Grid.Column="2" Text="1,050,000" Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource AlternateSurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="上下文请求值" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBox x:Name="WindowInputTextBox"
                                             Margin="0,7,0,0"
                                             Style="{StaticResource NumericInput}"
                                             AutomationProperties.Name="上下文请求精确值"
                                             TextChanged="ExactValue_TextChanged" />
                                    <TextBlock x:Name="WindowValueText"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource AlternateSurfaceBrush}" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="自动压缩阈值" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBox x:Name="CompactInputTextBox"
                                             Margin="0,7,0,0"
                                             Style="{StaticResource NumericInput}"
                                             AutomationProperties.Name="自动压缩阈值精确值"
                                             TextChanged="ExactValue_TextChanged" />
                                    <TextBlock x:Name="CompactValueText"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="ScopeValueText"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource TertiaryTextBrush}" />
                        <TextBlock x:Name="InputErrorText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="Collapsed" />

                        <Border x:Name="WarningBorder"
                                Margin="0,16,0,0"
                                Background="{DynamicResource WarningBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <TextBlock x:Name="WarningText" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="ConflictBorder"
                        Style="{StaticResource CardStyle}"
                        Background="{DynamicResource WarningBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ConflictTitleText"
                                   Text="检测到外部修改"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock x:Name="ConflictText"
                                   Margin="0,6,0,12"
                                   Text="你的草稿仍保留。请选择以最新磁盘配置为新基线，或明确丢弃草稿。"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   AutomationProperties.LiveSetting="Polite"
                                   TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="RebaseDraftButton"
                                    Content="保留草稿并基于新配置"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,10,8"
                                    Click="RebaseDraft_Click" />
                            <Button x:Name="ViewExternalChangesButton"
                                    Content="查看变化"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,8"
                                    Click="ViewExternalChanges_Click" />
                            <Button x:Name="DiscardDraftButton"
                                    Content="丢弃草稿并重载"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,8"
                                    Click="DiscardDraft_Click" />
                            <Button x:Name="ReloadConflictButton"
                                    Content="重新读取磁盘"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,0,8"
                                    Click="Reload_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="磁盘状态" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock x:Name="DiskStatusText" Margin="0,5,0,0" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="OpenConfigButton"
                                    Content="打开 config.toml"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0"
                                    Click="OpenConfig_Click" />
                            <Button Content="复制诊断信息"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="CopyDiagnostics_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                MinHeight="72"
                Background="{DynamicResource FooterBackgroundBrush}"
                BorderBrush="{DynamicResource FooterBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="这些数值是客户端配置请求，不能突破模型或账户的服务端硬上限。"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="重新加载" Style="{StaticResource SecondaryButton}" Margin="16,0,10,0" Click="Reload_Click" />
                <Button x:Name="ApplyButton" Grid.Column="2" Content="确认并应用" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
